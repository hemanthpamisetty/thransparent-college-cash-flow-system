# ==============================================================================
# College Cashflow Monitoring System - Backend Environment Configuration
# ==============================================================================
# INSTRUCTIONS FOR LOCAL COLLABORATION:
# 1. Copy this file to create your own local .env file:
#      PowerShell: Copy-Item .env.example .env
#      Bash:       cp .env.example .env
# 2. Update DB_PASSWORD with your local MySQL root/user password.
# 3. Update JWT_SECRET with a secure random key (at least 32 characters / 256 bits).
# 4. NEVER commit the .env file to Git (it is ignored by .gitignore).
# ==============================================================================

# Server Port (default 8081 matches frontend proxy)
PORT=8081

# MySQL Database Connection Settings
# Customize host/port if your local MySQL does not run on localhost:3306
DB_URL=jdbc:mysql://localhost:3306/college_cashflow?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password_here

# JWT Authentication Secret Key
# REQUIRED: Must be at least 32 characters (256 bits) for HMAC-SHA256
# Example generation in PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 40 | % {[char]$_})
JWT_SECRET=replace_with_your_own_secure_random_jwt_secret_at_least_32_chars

# Allowed CORS Origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
